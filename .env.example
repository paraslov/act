# Local PostgreSQL started with `pnpm db:up`.
DATABASE_URL=postgresql://act:act_local_password@localhost:5434/act
DATABASE_URL_UNPOOLED=postgresql://act:act_local_password@localhost:5434/act

# In Vercel, replace these with the platform-provided pooled and direct URLs.
# The migration script falls back to DATABASE_URL when DATABASE_URL_UNPOOLED
# is not available.
